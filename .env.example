# Copy to .env.local and adjust. Everything here is PUBLIC — Vite inlines every
# VITE_* variable into the JavaScript bundle as a literal string. Never put an
# API key, client secret or any bearer credential in this file.

VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=15000

# "mock" | "api" — the ONLY switch between fixture data and a real backend.
VITE_DATA_SOURCE=mock

VITE_ENABLE_LOGGING=true
