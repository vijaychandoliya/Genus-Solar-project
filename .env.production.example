# Build-time configuration for a production bundle.
#
# Two ways to supply these, pick one:
#   • CI / Docker  — pass them as --build-arg (see Dockerfile). Preferred: the
#     values live in the pipeline next to the environment they belong to.
#   • Bare build   — copy this file to .env.production and run `npm run build`.
#     Vite loads .env.production automatically in build mode.
#
# Everything here is PUBLIC. Vite inlines every VITE_* value into the JavaScript
# as a literal string — visible in devtools, in every CDN cache, forever. No API
# key, client secret or bearer token goes in this file. Secrets stay behind the
# backend, which exposes an endpoint instead.

# Required. No default in a production build: src/config/env.ts throws at boot
# when this is missing, which shows up as a blank screen. Absolute URL, no
# trailing slash, and https in any environment a real user touches.
VITE_API_BASE_URL=https://api.genus-solar.example/api

# Per-request timeout, milliseconds. Positive integer or the boot fails.
VITE_API_TIMEOUT=15000

# "api" for every deployed environment. "mock" links the fixture repositories
# into the bundle and must never be built for one — the Dockerfile refuses it.
VITE_DATA_SOURCE=api

# Console diagnostics. "false" in production.
VITE_ENABLE_LOGGING=false
